<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>GitHub × Supabase 操作マニュアル</title>
<style>
  :root{
    --paper:#f7f5f0; --card:#ffffff; --ink:#1c2621; --ink2:#6b7570; --line:#e4e0d6;
    --accent:#2f6feb; --accent-dk:#2455b8; --chip:#eef1f6; --label-bg:#f0f4ff; --label-bd:#c9d8fb; --label-fg:#2f5fc7; --label-en:#5a6b8c;
  }
  body.theme-sb{ --accent:#2ea36c; --accent-dk:#1e7f52; --chip:#eaf9f2; --label-bg:#eaf9f2; --label-bd:#b7ecd2; --label-fg:#1e9e63; --label-en:#4f8a72; }
  body.theme-cc{ --accent:#c1622f; --accent-dk:#9a4a20; --chip:#fbefe7; --label-bg:#fbefe7; --label-bd:#efcdb8; --label-fg:#a84f22; --label-en:#8a6a58; }
  *{box-sizing:border-box;}
  body{margin:0;background:var(--paper);color:var(--ink);
    font-family:-apple-system,BlinkMacSystemFont,"Hiragino Kaku Gothic ProN","Yu Gothic",sans-serif;line-height:1.7;}
  .page{max-width:640px;margin:0 auto;padding:24px 16px 60px;}

  /* ---------- TOC ---------- */
  .cover{padding:18px 4px 22px;border-bottom:3px double var(--ink);margin-bottom:22px;}
  .cover .kicker{font-family:ui-monospace,"SF Mono",Menlo,monospace;font-size:11px;letter-spacing:.2em;color:var(--ink2);}
  .cover h1{font-size:1.55rem;margin:6px 0 6px;line-height:1.35;}
  .cover p{margin:0;color:var(--ink2);font-size:.88rem;}
  .part{font-family:ui-monospace,"SF Mono",Menlo,monospace;font-size:11.5px;letter-spacing:.14em;color:var(--ink2);margin:26px 0 10px;display:flex;align-items:center;gap:10px;}
  .part::after{content:"";flex:1;height:1px;background:var(--line);}
  .toc-item{display:flex;gap:14px;align-items:center;background:var(--card);border:1px solid var(--line);border-radius:12px;
    padding:14px 16px;margin-bottom:10px;cursor:pointer;text-align:left;width:100%;font-family:inherit;color:inherit;}
  .toc-item:hover{border-color:var(--ink2);}
  .toc-no{flex:0 0 34px;height:34px;border-radius:50%;display:flex;align-items:center;justify-content:center;
    font-weight:bold;font-size:.85rem;color:#fff;}
  .toc-no.gh{background:#2f6feb}.toc-no.sb{background:#2ea36c}.toc-no.cc{background:#c1622f}
  .toc-body{flex:1;min-width:0;}
  .toc-title{font-weight:bold;font-size:.98rem;}
  .toc-title .en{display:block;font-weight:normal;font-size:.72rem;color:var(--ink2);}
  .toc-desc{font-size:.8rem;color:var(--ink2);margin-top:2px;}
  .toc-count{flex:0 0 auto;font-size:.72rem;color:var(--ink2);font-family:ui-monospace,Menlo,monospace;}
  .howto{margin-top:26px;background:#fffdf7;border:1px dashed var(--line);border-radius:10px;padding:12px 14px;font-size:.82rem;color:var(--ink2);}

  /* ---------- Chapter ---------- */
  .topbar{display:flex;align-items:center;gap:10px;margin-bottom:14px;}
  .back{background:transparent;border:1px solid var(--line);border-radius:999px;padding:6px 12px;font-size:.8rem;color:var(--ink2);cursor:pointer;font-family:inherit;}
  .back:hover{border-color:var(--ink2);}
  .chap-no{font-family:ui-monospace,Menlo,monospace;font-size:.75rem;color:var(--accent);font-weight:bold;letter-spacing:.08em;}
  .chap-head h2{font-size:1.25rem;margin:2px 0 2px;line-height:1.4;}
  .chap-head .en{font-size:.78rem;color:var(--ink2);}
  .progress-track{height:6px;background:var(--line);border-radius:99px;overflow:hidden;margin:14px 0 6px;}
  .progress-fill{height:100%;background:var(--accent);transition:width .25s;}
  .progress-label{font-size:.78rem;color:var(--ink2);text-align:right;margin-bottom:12px;}

  .card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:24px 20px;box-shadow:0 1px 3px rgba(0,0,0,.04);}
  .step-tag{display:inline-block;font-size:.72rem;font-weight:bold;color:var(--accent);background:var(--chip);padding:3px 10px;border-radius:999px;margin-bottom:10px;letter-spacing:.03em;}
  .step-title{font-size:1.18rem;font-weight:bold;margin:0 0 14px;line-height:1.4;}
  .step-title .en{display:block;font-size:.8rem;color:var(--ink2);font-weight:normal;margin-top:3px;}
  .step-body{font-size:.95rem;}
  .step-body p{margin:0 0 12px;}
  .step-body .en-inline{color:var(--ink2);font-size:.85rem;}
  .sub-list{margin:10px 0 14px;padding-left:0;list-style:none;}
  .sub-list li{display:flex;gap:9px;margin-bottom:9px;font-size:.9rem;}
  ol.sub-list li{display:list-item;}
  .sub-list li .dot{flex:0 0 6px;height:6px;border-radius:50%;background:var(--accent);margin-top:8px;}
  .ui-label{display:inline-block;background:var(--label-bg);border:1px solid var(--label-bd);color:var(--label-fg);padding:1px 8px;border-radius:5px;font-size:.84rem;font-weight:bold;margin:0 2px;}
  .ui-label .en{font-weight:normal;color:var(--label-en);}
  code{background:#00000010;padding:1px 5px;border-radius:3px;font-size:.85em;font-family:ui-monospace,"SF Mono",Menlo,monospace;}
  .path{display:block;background:#0d1117;color:#79c0ff;font-family:ui-monospace,"SFMono-Regular",Menlo,monospace;
    font-size:.78rem;padding:9px 12px;border-radius:8px;margin:10px 0;word-break:break-all;white-space:pre-wrap;overflow-x:auto;}
  .callout{border-radius:10px;padding:12px 14px;font-size:.86rem;margin-top:14px;display:flex;gap:9px;}
  .callout.warn{background:#fbeae7;border:1px solid #e3b3a8;color:#7a2d1e;}
  .callout.tip{background:#eaf2fb;border:1px solid #b9d3ef;color:#1e4a7a;}
  .callout.ok{background:#eaf5ee;border:1px solid #b7dcc4;color:#1e5c37;}
  .callout.danger{background:#fdeceb;border:1.5px solid #e2938a;color:#7a2318;font-weight:bold;}
  .shot{margin:14px auto 0;border:1px solid var(--line);border-radius:10px;overflow:hidden;max-width:460px;}
  .shot .shot{margin:0;border:none;max-width:none;}
  .shot img{display:block;width:100%;height:auto;max-height:420px;object-fit:contain;background:#0d1117;}
  .shot-cap{padding:8px 12px;font-size:.78rem;color:var(--ink2);background:#fbfbf9;border-top:1px solid var(--line);}
  .shot-note{border:1.5px dashed var(--line);border-radius:10px;padding:12px 14px;margin-top:14px;font-size:.83rem;color:var(--ink2);background:#fbfbf9;}
  .shot-note b{color:var(--ink);}

  .nav-row{display:flex;gap:10px;margin-top:20px;}
  .btn{padding:12px 18px;border-radius:8px;border:none;font-size:.92rem;font-weight:bold;cursor:pointer;font-family:inherit;}
  .btn.primary{background:var(--ink);color:#fff;flex:1;}
  .btn.primary:hover{background:var(--accent-dk);}
  .btn.ghost{background:transparent;color:var(--ink2);border:1px solid var(--line);}
  .btn:disabled{opacity:.35;cursor:not-allowed;}
  .dots{display:flex;gap:7px;justify-content:center;margin:16px 0 4px;flex-wrap:wrap;}
  .dot-btn{width:30px;height:30px;border-radius:50%;border:1.5px solid var(--line);background:#fff;color:var(--ink2);
    font-size:.76rem;font-weight:bold;cursor:pointer;display:flex;align-items:center;justify-content:center;font-family:inherit;}
  .dot-btn.active{background:var(--ink);color:#fff;border-color:var(--ink);}
  .dot-btn.done{border-color:var(--accent);color:var(--accent);}
  .dot-btn.note{border-style:dashed;}
  .toggle-all{text-align:center;margin-top:8px;}
  .toggle-all a{color:var(--ink2);font-size:.82rem;text-decoration:underline;cursor:pointer;}
  .all-steps .card{margin-bottom:14px;}
  .done-screen{text-align:center;padding:30px 10px;}
  .done-screen .big{font-size:2.4rem;margin-bottom:6px;}
  .done-screen h3{font-size:1.1rem;margin:0 0 8px;}
  .done-screen p{color:var(--ink2);font-size:.88rem;margin:0 0 16px;}
  .done-actions{display:flex;gap:10px;flex-wrap:wrap;justify-content:center;}
  .hidden{display:none !important;}
</style>
</head>
<body>
<div class="page">

  <!-- ===== 目次 ===== -->
  <section id="toc">
    <div class="cover">
      <div class="kicker">OPERATION MANUAL</div>
      <h1>GitHub × Supabase<br>操作マニュアル</h1>
      <p>HTMLアプリの公開・更新から、端末間の学習履歴同期まで</p>
    </div>
    <div id="tocList"></div>
    <div class="howto">
      💡 使い方：章をタップすると1ステップずつ表示されます。各章の「すべてのステップを表示」で一覧表示にも切り替えられます。<br>
      (Tap a chapter to go step by step. Use “Show all steps” inside a chapter for a full list.)
    </div>
  </section>

  <!-- ===== 章 ===== -->
  <section id="chapter" class="hidden">
    <div class="topbar">
      <button class="back" id="backBtn">← 目次 (Contents)</button>
    </div>
    <div class="chap-head">
      <div class="chap-no" id="chapNo"></div>
      <h2 id="chapTitle"></h2>
      <div class="en" id="chapTitleEn"></div>
    </div>
    <div class="progress-track"><div class="progress-fill" id="pf"></div></div>
    <div class="progress-label" id="pl"></div>

    <div id="stepper">
      <div class="card" id="cardBody"></div>
      <div class="dots" id="dots"></div>
      <div class="nav-row">
        <button class="btn ghost" id="prevBtn">戻る</button>
        <button class="btn primary" id="nextBtn">次へ</button>
      </div>
    </div>
    <div id="doneView" class="hidden"></div>
    <div id="allView" class="all-steps hidden"></div>
    <div class="toggle-all"><a id="showAllBtn">すべてのステップを表示 (Show all steps)</a></div>
  </section>

</div>

<script>
const CHAPTERS = [{"id": "upload", "part": "PART 1 — GitHub 基本操作", "icon": "📤", "title": "HTMLファイルのアップロード", "titleEn": "Uploading an HTML file", "desc": "既存リポジトリに新しいHTMLファイルを追加する", "theme": "gh", "steps": [{"title": "ブラウザでGitHubを開く", "titleEn": "Open GitHub in your browser", "body": "\n    <p>スマホ・PCどちらでもよいが、<b>GitHubアプリではなく必ずブラウザ（Chrome・Safariなど）<\/b>を使う。GitHubアプリはファイルの追加・編集に対応していない。<\/p>\n    <p class=\"en-inline\">(Not the GitHub app — use a browser such as Chrome or Safari. The GitHub app cannot add or edit files.)<\/p>\n    <div class=\"path\">https://github.com<\/div>\n    <p>ログインしていない場合は、右上の <span class=\"ui-label\">Sign in <span class=\"en\">(サインイン)<\/span><\/span> からログインする。<\/p>\n  ", "callout": {"type": "tip", "text": "アドレスバーに直接URLを打ち込む方が、検索経由で開くより確実で早い。 (Typing the URL directly is faster and more reliable than searching for it.)"}}, {"title": "アップロード先のリポジトリを開く", "titleEn": "Open the target repository", "body": "\n    <p>ファイルを追加したいリポジトリ（保管庫）を開く。トップページ、または画面左の <span class=\"ui-label\">Top repositories<\/span> の一覧から選ぶ。<\/p>\n    <p class=\"en-inline\">(Open the repository — the storage box for your project — you want to add the file to.)<\/p>\n    <div class=\"path\">https://github.com/ユーザー名/リポジトリ名<\/div>\n    <p>開いたら、画面上部に表示されているリポジトリ名が、目的のものと合っているか<b>必ず確認<\/b>する。似た名前のリポジトリを間違えて開くミスが起きやすい。<\/p>\n  ", "callout": {"type": "warn", "text": "リポジトリ名の確認を絶対に省略しないこと。 (Never skip checking the repository name — this is the most common mistake.)"}}, {"title": "「Add file」ボタンを探す", "titleEn": "Find the “Add file” button", "body": "\n    <p>リポジトリのファイル一覧の右上あたりにある、<span class=\"ui-label\">Add file <span class=\"en\">(ファイルを追加)<\/span><\/span> というボタンを探す。<\/p>\n    <p class=\"en-inline\">(Look for the “Add file” button, usually above the file list, top-right area.)<\/p>\n    <div class=\"shot\"><img src=\"data:image/jpeg;base64,\" alt=\"実際の画面：ITpassリポジトリの「新しいファイルを作成する」リンク\"><div class=\"shot-cap\">実際の画面：ITpassリポジトリの「新しいファイルを作成する」リンク<\/div><\/div>\n  ", "callout": {"type": "tip", "text": "ボタンが見当たらない場合は、ブラウザのメニューから「PC版サイトを表示」に切り替えると出てくることが多い。 (If you can't find the button, switch your browser to “Desktop site” mode.)"}}, {"title": "「Upload files」を選択する", "titleEn": "Select “Upload files”", "body": "\n    <p><span class=\"ui-label\">Add file<\/span> をタップすると小さいメニューが開く。その中の <span class=\"ui-label\">Upload files <span class=\"en\">(ファイルをアップロード)<\/span><\/span> を選ぶ。<\/p>\n    <p class=\"en-inline\">(Tapping “Add file” opens a small menu — choose “Upload files” from it.)<\/p>\n    <ul class=\"sub-list\">\n      <li><span class=\"dot\"><\/span><span><span class=\"ui-label\">Create new file<\/span> ではない方（そちらはその場でコードを貼り付ける用）<\/span><\/li>\n      <li><span class=\"dot\"><\/span><span>今回は手元にできあがったHTMLファイルがある前提なので <span class=\"ui-label\">Upload files<\/span> を選ぶ<\/span><\/li>\n    <\/ul>\n  "}, {"title": "アップロードするファイルを選ぶ", "titleEn": "Choose the file to upload", "body": "\n    <p>画面中央に、ファイルをドラッグ＆ドロップする枠と、<span class=\"ui-label\">choose your files <span class=\"en\">(ファイルを選択)<\/span><\/span> というリンクが表示される。<\/p>\n    <p class=\"en-inline\">(You'll see a drop zone and a “choose your files” link in the middle of the screen.)<\/p>\n    <ol class=\"sub-list\" style=\"list-style:decimal;padding-left:20px;\">\n      <li><span class=\"ui-label\">choose your files<\/span> をタップする<\/li>\n      <li>スマホの場合、写真アプリ・ファイルアプリなどの選択画面が開く<\/li>\n      <li>アップロードしたいHTMLファイルをタップして選ぶ<\/li>\n    <\/ol>\n    <div class=\"shot\"><img src=\"data:image/jpeg;base64,\" alt=\"実際の画面：ファイル選択枠・選択済みファイル・コミット欄がまとめて見える状態\"><div class=\"shot-cap\">実際の画面：ファイル選択枠・選択済みファイル・コミット欄がまとめて見える状態<\/div><\/div>\n  ", "callout": {"type": "tip", "text": "HTMLファイルが「メモ」アプリなどに保存されている場合、先に「ファイル」アプリへ.html形式で保存し直しておくとここでスムーズに選べる。 (If your HTML is saved in a notes app, save it as an .html file in your Files app first.)"}}, {"title": "ファイルが選択されたことを確認する", "titleEn": "Confirm the file was selected", "body": "\n    <p>選択が終わると、ドロップ枠の下に、選んだファイル名（例：<code>index.html<\/code>）が一覧として表示される。<\/p>\n    <p class=\"en-inline\">(Once selected, the file name — e.g. index.html — appears listed below the drop zone.)<\/p>\n    <p>ファイル名の右側に「×」マークがあれば、それは選択の取り消しボタン。間違ったファイルを選んだ場合はここで消せる。<\/p>\n  ", "callout": {"type": "warn", "text": "複数ファイルを一気に選ぶこともできるが、今回は基本1ファイルずつでよい。 (You can select multiple files at once, but one at a time is usually simplest.)"}}, {"title": "コミットメッセージを確認し「Commit changes」を押す", "titleEn": "Check the commit message, then click “Commit changes”", "body": "\n    <p>画面を下にスクロールすると <span class=\"ui-label\">Commit changes <span class=\"en\">(変更を確定する)<\/span><\/span> という緑のボタンが出てくる。<\/p>\n    <p class=\"en-inline\">(Scroll down to find the green “Commit changes” button.)<\/p>\n    <ul class=\"sub-list\">\n      <li><span class=\"dot\"><\/span><span>上部の入力欄には自動で「Add files via upload」のようなメッセージが入っている。空欄でも問題ないが、内容が分かるよう一言添えてもよい<\/span><\/li>\n      <li><span class=\"dot\"><\/span><span><span class=\"ui-label\">Commit directly to the main branch <span class=\"en\">(mainブランチに直接コミットする)<\/span><\/span> が選ばれていることを確認する（通常はこれが初期選択）<\/span><\/li>\n      <li><span class=\"dot\"><\/span><span>緑の <span class=\"ui-label\">Commit changes<\/span> ボタンをタップする<\/span><\/li>\n    <\/ul>\n  ", "callout": {"type": "tip", "text": "迷ったら選択肢はいじらず、初期状態のままCommit changesを押せばよい。 (If unsure, leave the options as-is and just click Commit changes.)"}}, {"title": "アップロード完了を確認する", "titleEn": "Confirm the upload is complete", "body": "\n    <p>コミット後、自動的にリポジトリのファイル一覧画面に戻る。アップロードしたファイル名がそこに表示されていれば成功。<\/p>\n    <p class=\"en-inline\">(After committing, you'll return to the file list — the uploaded file appearing there means it worked.)<\/p>\n    <p>ファイル名をタップして開けば、中身がそのまま表示されるので、正しいファイルが入っているか一度確認しておくと安心。<\/p>\n    <div class=\"shot\"><img src=\"data:image/jpeg;base64,\" alt=\"実際の画面：アップロード完了後のファイル一覧\"><div class=\"shot-cap\">実際の画面：アップロード完了後のファイル一覧<\/div><\/div>\n  ", "callout": {"type": "ok", "text": "GitHub Pagesを有効化済みのリポジトリであれば、1〜2分後に公開URLにも反映される。 (If GitHub Pages is already enabled for this repo, the change appears on the live URL within a minute or two.)"}}]}, {"id": "publish", "part": "PART 1 — GitHub 基本操作", "icon": "🌐", "title": "公開URLの発行（GitHub Pages）", "titleEn": "Publishing a URL", "desc": "全端末からアクセスできるURLを発行する（リポジトリごとに1回）", "theme": "gh", "steps": [{"title": "これから何をするかの前提", "titleEn": "What this section actually does", "body": "\n    <p>今の状態は「GitHubにファイルは保存されているが、まだ誰も見られる形になっていない」段階。この手順で、<b>誰でもURLを開けば見られる状態（公開）<\/b>にする。<\/p>\n    <p class=\"en-inline\">(Right now the file is saved on GitHub, but no one can view it yet. This section makes it publicly viewable via a URL.)<\/p>\n    <p>使う機能は <span class=\"ui-label\">GitHub Pages<\/span> という、GitHubが無料で提供しているホスティング機能。<\/p>\n  ", "callout": {"type": "tip", "text": "この設定は1つのリポジトリにつき最初の1回だけでよい。以降ファイルを更新しても、この設定をやり直す必要はない。 (You only need to do this once per repository — future file updates won't require repeating this step.)"}}, {"title": "対象のリポジトリを開く", "titleEn": "Open the target repository", "body": "\n    <p>公開したいHTMLファイルが入っているリポジトリを開く。<\/p>\n    <div class=\"path\">https://github.com/ユーザー名/リポジトリ名<\/div>\n    <p>画面上部のリポジトリ名が、公開したいものと合っているか確認する。<\/p>\n  ", "callout": {"type": "warn", "text": "公開はリポジトリ単位の設定。違うリポジトリで設定しても意味がない。 (This setting applies per-repository — enabling it on the wrong one won't do anything.)"}}, {"title": "「Settings（設定）」を開く", "titleEn": "Open “Settings”", "body": "\n    <p>リポジトリ上部のタブ一覧（Code / Issues / Pull requests …）を右へたどる。全部見えない場合は <span class=\"ui-label\">もっと <span class=\"en\">(More)<\/span><\/span> というメニューの中に <span class=\"ui-label\">設定 <span class=\"en\">(Settings)<\/span><\/span> が入っている。<\/p>\n    <p class=\"en-inline\">(Look along the top tabs — if they don't all fit, “Settings” is tucked inside the “More” menu.)<\/p>\n    <div class=\"shot\"><img src=\"data:image/jpeg;base64,\" alt=\"実際の画面：「もっと」メニューを開くと「設定」が入っている\"><div class=\"shot-cap\">実際の画面：「もっと」メニューを開くと「設定」が入っている<\/div><\/div>\n  "}, {"title": "左メニューの「ページ（Pages）」を開く", "titleEn": "Open “Pages” in the left sidebar", "body": "\n    <p>設定画面の左側に、いくつも項目が並んだメニューがある。その中から <span class=\"ui-label\">ページ <span class=\"en\">(Pages)<\/span><\/span> をタップする。<\/p>\n    <p class=\"en-inline\">(In the settings screen, find “Pages” in the left-hand menu list.)<\/p>\n    <p><span class=\"ui-label\">コードスペース <span class=\"en\">(Codespaces)<\/span><\/span> のすぐ下あたりにあることが多い。<\/p>\n    <div class=\"shot\"><img src=\"data:image/jpeg;base64,\" alt=\"実際の画面：Pages設定画面（まだ無効の状態）\"><div class=\"shot-cap\">実際の画面：Pages設定画面（まだ無効の状態）<\/div><\/div>\n  "}, {"title": "公開する場所（ブランチ）を設定する", "titleEn": "Choose the branch to publish from", "body": "\n    <p>「ビルドとデプロイ <span class=\"en\">(Build and deployment)<\/span>」という項目の中に、<span class=\"ui-label\">支店 <span class=\"en\">(Branch)<\/span><\/span> の設定欄がある。<\/p>\n    <p class=\"en-inline\">(Under “Build and deployment,” there's a “Branch” selector.)<\/p>\n    <ul class=\"sub-list\">\n      <li><span class=\"dot\"><\/span><span>左のプルダウンで <span class=\"ui-label\">main <span class=\"en\">(主要)<\/span><\/span> を選ぶ<\/span><\/li>\n      <li><span class=\"dot\"><\/span><span>右のフォルダ指定は <span class=\"ui-label\">/ (root) <span class=\"en\">(根)<\/span><\/span> のままでよい（HTMLファイルをリポジトリ直下に置いている場合）<\/span><\/li>\n      <li><span class=\"dot\"><\/span><span><span class=\"ui-label\">保存 <span class=\"en\">(Save)<\/span><\/span> をタップ<\/span><\/li>\n    <\/ul>\n    <div class=\"shot\"><img src=\"data:image/jpeg;base64,\" alt=\"実際の画面：ブランチを「主に(main)」、フォルダを「/(根)」に設定した状態\"><div class=\"shot-cap\">実際の画面：ブランチを「主に(main)」、フォルダを「/(根)」に設定した状態<\/div><\/div>\n  ", "callout": {"type": "warn", "text": "ここで「なし (None)」のままだとPagesは無効のまま。必ずmainを選んで保存する。 (If this is left as “None,” Pages stays disabled — make sure to select “main” and save.)"}}, {"title": "1〜2分待つ", "titleEn": "Wait a minute or two", "body": "\n    <p>保存すると、GitHub側でサイトを組み立てる処理（ビルド）が始まる。この処理には数十秒〜2分ほどかかる。<\/p>\n    <p class=\"en-inline\">(After saving, GitHub builds your site in the background — this typically takes anywhere from a few seconds up to about two minutes.)<\/p>\n    <p>この間、画面は動かさずそのままにしておいてよい。<\/p>\n  "}, {"title": "公開URLを確認する", "titleEn": "Find your published URL", "body": "\n    <p>少し待ってから、同じ「ページ（Pages）」設定画面をもう一度開く（一度他の画面に移動してから戻ると確実）。<\/p>\n    <p class=\"en-inline\">(After waiting, revisit the same Pages settings screen — leaving and coming back is the most reliable way to refresh it.)<\/p>\n    <p>画面上部に「あなたのサイトは<span class=\"ui-label\">https://ユーザー名.github.io/リポジトリ名/<\/span>で公開されています」という緑色の案内が表示されていれば成功。<\/p>\n    <div class=\"path\">https://usoyanda.github.io/リポジトリ名/<\/div>\n    <div class=\"shot\"><img src=\"data:image/jpeg;base64,\" alt=\"実際の画面：ITpassリポジトリで公開URLが発行された状態\"><div class=\"shot-cap\">実際の画面：ITpassリポジトリで公開URLが発行された状態<\/div><\/div>\n  ", "callout": {"type": "ok", "text": "このURLが「全端末からアクセスできるURL」そのもの。ブックマークしたり、社員に共有したりできる。 (This URL is the one accessible from any device — bookmark it or share it with others.)"}}, {"title": "実際に別の端末で開いて確認する", "titleEn": "Test it on a different device", "body": "\n    <p>発行されたURLを、スマホとPCなど<b>違う端末・違うブラウザ<\/b>で開いてみる。同じ内容が表示されれば、正しく全端末からアクセスできる状態になっている。<\/p>\n    <p class=\"en-inline\">(Open the URL on a different device or browser — seeing the same content confirms it's truly accessible from anywhere.)<\/p>\n    <p>表示が崩れる・真っ白になるなどの場合は、リポジトリ内のファイル名や参照パス（画像やCSSの読み込み先など）を見直す。<\/p>\n  "}, {"title": "URLは今後も変わらないことを理解しておく", "titleEn": "Remember this URL stays the same going forward", "body": "\n    <p>一度発行されたこのURLは、<b>ファイルの中身を何回更新しても変わらない<\/b>。「既存ファイルの修正と更新」の手順でindex.htmlを書き換えても、URLはそのまま。<\/p>\n    <p class=\"en-inline\">(This URL never changes, no matter how many times you update the file's contents afterward.)<\/p>\n    <p>つまり一度共有すれば、以降は中身の更新だけを気にすればよく、URLの送り直しは不要。<\/p>\n  ", "callout": {"type": "ok", "text": "次に何か直したくなったら「既存ファイルの修正と更新」の手順に進めばよい。公開設定はもうこれで完了している。 (Next time you need a fix, just follow “Editing and updating an existing file” — this publishing setup is already done.)"}}]}, {"id": "edit", "part": "PART 1 — GitHub 基本操作", "icon": "🔧", "title": "既存ファイルの修正と更新", "titleEn": "Editing and updating a file", "desc": "Claudeで直したコードを丸ごと差し替えて反映する", "theme": "gh", "steps": [{"title": "ダッシュボードを開き、修正したいリポジトリを探す", "titleEn": "Open the dashboard and find the repository to edit", "body": "\n    <p>ブラウザで <span class=\"ui-label\">github.com<\/span> を開くと、この <span class=\"ui-label\">ダッシュボード <span class=\"en\">(Dashboard)<\/span><\/span> 画面が表示される。<\/p>\n    <p class=\"en-inline\">(This is the Dashboard screen you land on after opening github.com.)<\/p>\n    <p>画面左側の <span class=\"ui-label\">Top repositories<\/span> に、これまで使ったリポジトリが並んでいる。今回修正したいリポジトリ名をタップする。<\/p>\n    <div class=\"shot\">\n      <img src=\"data:image/jpeg;base64,\" alt=\"GitHub Dashboard画面\">\n      <div class=\"shot-cap\">左側に usoyanda/hiragana-50、usoyanda/ITpass、usoyanda/poker_dealer などのリポジトリ一覧が並んでいる。<\/div>\n    <\/div>\n  ", "callout": {"type": "warn", "text": "似た名前のリポジトリ（hiragana-50 / ITpass / poker_dealer / English など）が並ぶので、タップする前に名前を必ず確認する。 (Several similarly named repositories are listed — double-check the name before tapping.)"}}, {"title": "リポジトリのトップ画面を確認する", "titleEn": "Confirm you're on the repository's top page", "body": "\n    <p>リポジトリを開くと、上部に <span class=\"ui-label\">所有者名 / リポジトリ名<\/span> が表示される。ここが目的のリポジトリと一致しているか確認する。<\/p>\n    <p class=\"en-inline\">(Check that the owner name and repository name shown at the top match the one you intended to open.)<\/p>\n    <div class=\"shot\">\n      <img src=\"data:image/jpeg;base64,\" alt=\"リポジトリのトップ画面（英語リポジトリの例）\">\n      <div class=\"shot-cap\">画面上部に「ウソヤンダ / 英語」と表示されている。これがリポジトリ名の確認ポイント。<\/div>\n    <\/div>\n    <p>ファイルがまだ何もない場合はこのような案内画面が出るが、既にファイルがあるリポジトリではこの下にファイル一覧が表示される。<\/p>\n  "}, {"title": "修正したいファイルを開く", "titleEn": "Open the file you want to edit", "body": "\n    <p>ファイル一覧の中から、修正したいファイル（例：<code>index.html<\/code>）をタップして開く。<\/p>\n    <p class=\"en-inline\">(Tap the file you want to change — e.g. index.html — from the file list.)<\/p>\n    <p>開くと、コードの中身がそのまま画面に表示される（プレビューではなく、生のコードが行番号付きで並ぶ状態）。<\/p>\n  ", "callout": {"type": "tip", "text": "ファイルが複数ある場合は、拡張子（.html .css .js）を見て、どれを直すべきか迷ったらClaudeに聞き返してよい。 (If there are multiple files, check the extension — .html, .css, .js — and ask Claude if unsure which to edit.)"}}, {"title": "編集モードに入る（鉛筆アイコン）", "titleEn": "Enter edit mode (the pencil icon)", "body": "\n    <p>ファイル表示画面の右上あたりにある <span class=\"ui-label\">✎ 鉛筆アイコン <span class=\"en\">(Edit this file)<\/span><\/span> をタップする。<\/p>\n    <p class=\"en-inline\">(Tap the pencil icon near the top-right of the file view.)<\/p>\n    <p>タップすると、コードがそのまま書き換え可能なテキストエリアに切り替わる。<\/p>\n    <div class=\"shot\"><img src=\"data:image/jpeg;base64,\" alt=\"実際の画面：編集モードでファイル名を書き換えている例（index.htmlへのリネーム）\"><div class=\"shot-cap\">実際の画面：編集モードでファイル名を書き換えている例（index.htmlへのリネーム）<\/div><\/div>\n  ", "callout": {"type": "warn", "text": "鉛筆アイコンが見当たらない場合、ブラウザが「PC版サイト」表示になっていない可能性がある。ブラウザメニューから切り替える。 (If you can't find the pencil icon, try switching your browser to “Desktop site” mode.)"}}, {"title": "中身を全選択して削除する", "titleEn": "Select all the content and delete it", "body": "\n    <p>編集エリアの中を1回タップしてから、全選択の操作を行う。<\/p>\n    <ul class=\"sub-list\">\n      <li><span class=\"dot\"><\/span><span>スマホ：編集エリアを長押し →「すべて選択 <span class=\"en\">(Select all)<\/span>」をタップ<\/span><\/li>\n      <li><span class=\"dot\"><\/span><span>PC：編集エリア内をクリックしてから <code>Ctrl+A<\/code>（Macは<code>⌘+A<\/code>）<\/span><\/li>\n    <\/ul>\n    <p>全選択できたら、そのままキーボードの削除キー（Backspace / Delete）を押して、中身を空にする。<\/p>\n    <p class=\"en-inline\">(Select everything, then delete it so the editor is empty.)<\/p>\n  "}, {"title": "Claudeからもらった新しいコードを貼り付ける", "titleEn": "Paste in the new code from Claude", "body": "\n    <p>Claudeでコピーしておいた、修正済みの<b>完成版コード全体<\/b>を、空になった編集エリアに貼り付ける。<\/p>\n    <p class=\"en-inline\">(Paste the entire updated code you copied from Claude into the now-empty editor.)<\/p>\n    <ul class=\"sub-list\">\n      <li><span class=\"dot\"><\/span><span>スマホ：長押し →「貼り付け <span class=\"en\">(Paste)<\/span>」<\/span><\/li>\n      <li><span class=\"dot\"><\/span><span>PC：<code>Ctrl+V<\/code>（Macは<code>⌘+V<\/code>）<\/span><\/li>\n    <\/ul>\n  ", "callout": {"type": "warn", "text": "一部だけ書き換えるのではなく、必ずファイル全体を丸ごと置き換える。中途半端に混ぜるとコードが壊れる原因になる。 (Always replace the whole file, not just part of it — mixing old and new code is the most common cause of breakage.)"}}, {"title": "画面を下にスクロールする", "titleEn": "Scroll down to the bottom of the page", "body": "\n    <p>貼り付けが終わったら、そのまま画面を一番下までスクロールする。コミット用の入力欄とボタンはページの下部にある。<\/p>\n    <p class=\"en-inline\">(After pasting, scroll all the way down — the commit box and button are at the bottom of the page.)<\/p>\n  "}, {"title": "コミットメッセージを確認し「Commit changes」を押す", "titleEn": "Check the commit message, then click “Commit changes”", "body": "\n    <p>上部の入力欄には自動で「Update index.html」のようなメッセージが入っている。そのままでよい。<\/p>\n    <p class=\"en-inline\">(The message box auto-fills with something like “Update index.html” — leaving it as-is is fine.)<\/p>\n    <ul class=\"sub-list\">\n      <li><span class=\"dot\"><\/span><span><span class=\"ui-label\">Commit directly to the main branch <span class=\"en\">(mainブランチに直接コミットする)<\/span><\/span> が選ばれていることを確認<\/span><\/li>\n      <li><span class=\"dot\"><\/span><span>緑の <span class=\"ui-label\">Commit changes <span class=\"en\">(変更を確定する)<\/span><\/span> ボタンをタップ<\/span><\/li>\n    <\/ul>\n    <div class=\"shot\"><img src=\"data:image/jpeg;base64,\" alt=\"実際の画面：コミット確認ダイアログ\"><div class=\"shot-cap\">実際の画面：コミット確認ダイアログ<\/div><\/div>\n  ", "callout": {"type": "tip", "text": "迷ったら選択肢はいじらず、初期状態のままCommit changesを押せばよい。 (If unsure, leave the options as-is and just click Commit changes.)"}}, {"title": "公開サイトで反映を確認する", "titleEn": "Confirm the change on the live site", "body": "\n    <p>コミット後、1〜2分待ってから公開URL（<code>usoyanda.github.io/リポジトリ名<\/code>）を開き直す（リロードする）。<\/p>\n    <p class=\"en-inline\">(Wait a minute or two after committing, then reload the live URL.)<\/p>\n    <p>修正した内容が反映されていれば成功。反映されていない場合は、ブラウザのキャッシュが古い可能性があるので、強制リロード（スマホなら一度タブを閉じて開き直す）を試す。<\/p>\n    <div class=\"shot\"><img src=\"data:image/jpeg;base64,\" alt=\"実際の画面：公開サイトに反映された状態（ITパスポート過去問道場）\"><div class=\"shot-cap\">実際の画面：公開サイトに反映された状態（ITパスポート過去問道場）<\/div><\/div>\n  ", "callout": {"type": "ok", "text": "URLは書き換え前と変わらない。一度共有したURLは、中身を何度更新しても送り直す必要がない。 (The URL never changes — once shared, you never need to resend it, no matter how many times you update the content.)"}}]}, {"id": "naming", "part": "PART 1 — GitHub 基本操作", "icon": "🏷️", "title": "ファイル名の付け方とリネーム", "titleEn": "Naming and renaming files", "desc": "index.htmlの役割と、1リポジトリに複数アプリを置く構成", "theme": "gh", "steps": [{"title": "index.html の役割を知る", "titleEn": "What index.html does", "body": "\n<p><code>index.html<\/code> という名前のファイルは、そのリポジトリの<b>表紙（トップページ）<\/b>として扱われる特別な名前。ファイル名を省略した短いURLで開けるのは、このファイルだけ。<\/p>\n<p class=\"en-inline\">(A file named index.html is treated as the repository's front page — it's the only file reachable via the short URL without a filename.)<\/p>\n<div class=\"path\">https://usoyanda.github.io/dealer_app/            ← index.html が開く\nhttps://usoyanda.github.io/dealer_app/index.html  ← 同じもの<\/div>\n", "callout": {"type": "tip", "text": "「URLを発行するなら index.html にしろ」と言われるのはこのため。ただし必須なのは“短いURLで開きたいとき”だけ。 (You only need index.html if you want the short URL.)"}}, {"title": "index.html 以外の名前でも公開される", "titleEn": "Other filenames are published too", "body": "\n<p>ファイル名まで含めたURLで開くなら、名前は自由。GitHub Pagesはリポジトリ内のHTMLを全部公開している。<\/p>\n<p class=\"en-inline\">(Any HTML file in the repo is published — just include its filename in the URL.)<\/p>\n<div class=\"path\">https://usoyanda.github.io/dealer_app/roulette.html\nhttps://usoyanda.github.io/dealer_app/blackjack.html<\/div>\n"}, {"title": "1リポジトリに複数アプリを置く構成", "titleEn": "Hosting several apps in one repository", "body": "\n<p>同じリポジトリ内でファイル名は重複できないので、<code>index.html<\/code> は1つしか置けない。複数アプリを置くなら次の形にする。<\/p>\n<ul class=\"sub-list\">\n<li><span class=\"dot\"><\/span><span><code>index.html<\/code>：メニュー（目次）専用ページ。各アプリへのリンクを並べる<\/span><\/li>\n<li><span class=\"dot\"><\/span><span>各アプリ：用途が分かる名前にする（<code>roulette.html<\/code> / <code>blackjack.html<\/code> / <code>baccarat.html<\/code> / <code>poker.html<\/code>）<\/span><\/li>\n<\/ul>\n", "callout": {"type": "ok", "text": "命名ルールは「小文字・英語・用途名.html」で統一すると、ファイル一覧で迷わない。 (Use lowercase English names describing the app, e.g. roulette.html.)"}}, {"title": "リネームしてよいか判断する", "titleEn": "When renaming is safe", "body": "\n<p>リネーム操作自体はGitHub上で何の問題もない。困るのは<b>URLが変わること<\/b>だけ。<\/p>\n<ul class=\"sub-list\">\n<li><span class=\"dot\"><\/span><span>まだURLを誰にも共有していない → 自由にリネームしてよい<\/span><\/li>\n<li><span class=\"dot\"><\/span><span>すでにURLを共有・ブックマークしている → 旧URLはリンク切れ（404）になる。新URLを送り直す必要がある<\/span><\/li>\n<\/ul>\n<p>リネーム手順は「既存ファイルの修正と更新」と同じ編集画面で、上部のファイル名欄を書き換えてコミットするだけ。<\/p>\n"}, {"title": "トップページを差し替えるときの順番", "titleEn": "Order of operations when replacing the top page", "body": "\n<p>今の <code>index.html<\/code> がアプリ本体で、それをメニューページに差し替えたい場合は、<b>必ずこの順番<\/b>で行う。<\/p>\n<ol class=\"sub-list\" style=\"list-style:decimal;padding-left:20px;\">\n<li>今の <code>index.html<\/code> をアプリ名（例：<code>blackjack.html<\/code>）にリネームしてコミット<\/li>\n<li>他のファイルも必要ならリネーム（例：<code>dealer_sim_roulette.html<\/code> → <code>roulette.html<\/code>）<\/li>\n<li>最後に、新しいメニュー用 <code>index.html<\/code> をアップロード<\/li>\n<\/ol>\n", "callout": {"type": "danger", "text": "順番を逆にすると、アプリ本体を新しいメニューページで上書きして消してしまう。リネームが先、アップロードが最後。 (Reversing the order overwrites your app with the menu page — rename first, upload last.)"}}]}, {"id": "code", "part": "PART 2 — Claude Code", "icon": "🤖", "title": "Claude Codeでリポジトリを直接修正する", "titleEn": "Editing the repo with Claude Code", "desc": "コピペ不要。ClaudeがGitHubを直接書き換える", "theme": "cc", "steps": [{"title": "Claude Code を使う理由", "titleEn": "Why use Claude Code", "body": "\n<p>チャット版のClaudeで修正すると、毎回HTML全体を出力し直し、それをGitHubに手で貼り替える必要がある。Claude Codeなら、Claudeが<b>GitHubのリポジトリを直接読んで、直接書き換える<\/b>。コピペ作業がなくなり、変更も差分だけで済む。<\/p>\n<p class=\"en-inline\">(Claude Code reads and edits your GitHub repository directly — no more copy-pasting whole files.)<\/p>\n", "callout": {"type": "tip", "text": "会社PCでも、ブラウザで claude.ai/code を開けば使える。 (Works from a browser at claude.ai/code, including on a work PC.)"}}, {"title": "claude.ai/code を開いてサインインする", "titleEn": "Open claude.ai/code and sign in", "body": "\n<div class=\"path\">https://claude.ai/code<\/div>\n<p>いつものClaudeアカウントでサインインする。<\/p>\n<p class=\"en-inline\">(Sign in with your usual Claude account.)<\/p>\n", "callout": {"type": "ok", "text": "STEP 2〜4 は最初の1回だけ。 (Steps 2–4 are one-time setup.)"}}, {"title": "GitHubと接続する", "titleEn": "Connect GitHub", "body": "\n<p>サインイン後、GitHubへの接続を求められる。画面の指示に従って <span class=\"ui-label\">Claude GitHub App<\/span> をインストールする。<\/p>\n<p class=\"en-inline\">(After signing in you'll be asked to connect GitHub — install the Claude GitHub App as prompted.)<\/p>\n<p>アクセスを許可するリポジトリを聞かれたら、<span class=\"ui-label\">Only select repositories <span class=\"en\">(選択したリポジトリのみ)<\/span><\/span> を選び、作業するリポジトリ（例：<code>dealer_app<\/code>）だけにチェックを入れる。<\/p>\n", "callout": {"type": "tip", "text": "後からリポジトリを追加したくなったら、GitHubの設定でアプリの許可範囲を広げられる。 (You can grant access to more repositories later.)"}}, {"title": "環境（Environment）を作る", "titleEn": "Create an environment", "body": "\n<p>続いてクラウド環境の作成を求められる。名前やネットワーク設定の欄があるが、<b>デフォルトのまま<\/b> <span class=\"ui-label\">Create environment <span class=\"en\">(環境を作成)<\/span><\/span> を押せばよい。<\/p>\n<p class=\"en-inline\">(Leave the defaults and click “Create environment.”)<\/p>\n"}, {"title": "リポジトリを選んで指示を書く", "titleEn": "Pick the repository and write your request", "body": "\n<p>リポジトリ一覧から対象（例：<code>dealer_app<\/code>）を選び、入力欄に指示を書いて送信する。<\/p>\n<div class=\"path\">roulette.html を修正してください。\n・（直したい内容を箇条書きで具体的に）\nindex.html と blackjack.html には触らないでください。<\/div>\n", "callout": {"type": "tip", "text": "1回の依頼＝1テーマに絞る。「いい感じに」ではなく、何をどう変えたいかを具体的に書くほど結果がブレない。 (One topic per request, and be specific.)"}}, {"title": "作業を見守る", "titleEn": "Watch Claude work", "body": "\n<p>Claudeがリポジトリを読み込み、ファイルを修正していく様子が表示される。途中で追加の指示を送ることもできる。<\/p>\n<p class=\"en-inline\">(You'll see Claude read the repo and edit files; you can send follow-up instructions mid-way.)<\/p>\n<p>作業が終わると、変更内容は<b>別のブランチ<\/b>としてGitHubに送られる。<\/p>\n"}, {"title": "⚠️ Pull Request をマージする", "titleEn": "Merge the Pull Request", "body": "\n<p>ここが最大の落とし穴。Claudeの変更は <code>main<\/code> ではなく別ブランチに入っている。<b>GitHub Pagesは main から公開している<\/b>ので、このままではサイトに反映されない。<\/p>\n<ol class=\"sub-list\" style=\"list-style:decimal;padding-left:20px;\">\n<li>Claude Code画面の <span class=\"ui-label\">Create PR<\/span>、またはGitHubのリポジトリ画面に出る <span class=\"ui-label\">Compare &amp; pull request<\/span> を押す<\/li>\n<li><span class=\"ui-label\">Create pull request <span class=\"en\">(プルリクエストを作成)<\/span><\/span> を押す<\/li>\n<li>緑の <span class=\"ui-label\">Merge pull request <span class=\"en\">(マージ)<\/span><\/span> → <span class=\"ui-label\">Confirm merge <span class=\"en\">(マージを確定)<\/span><\/span> を押す<\/li>\n<\/ol>\n", "callout": {"type": "danger", "text": "マージを忘れると「直したはずなのにサイトが変わらない」状態になる。 (Forget to merge and the live site won't change.)"}}, {"title": "公開サイトで確認する", "titleEn": "Check the live site", "body": "\n<p>マージ後1〜2分待って、公開URLを開き直す。<\/p>\n<div class=\"path\">https://usoyanda.github.io/dealer_app/roulette.html<\/div>\n<p>反映されていなければ、タブを閉じて開き直す（キャッシュ対策）。<\/p>\n", "callout": {"type": "ok", "text": "以降の修正は STEP 5〜8 の繰り返しだけ。 (From now on, just repeat steps 5–8.)"}}]}, {"id": "org", "part": "PART 3 — Supabase 端末間同期", "icon": "🏢", "title": "Supabaseの登録と組織の作成", "titleEn": "Sign-up and Organization", "desc": "サインアップ直後の「組織を作る」画面の進み方", "theme": "sb", "steps": [{"title": "これから何をするかの前提", "titleEn": "What “Organization” means here", "body": "\n    <p>これはGitHubの操作ではなく、<b>Supabase<\/b>（学習履歴を保存するクラウドDBサービス）の話。Supabaseにサインアップすると、プロジェクトを作る<b>前<\/b>に、必ず「組織（Organization）」という入れ物を1つ作らされる。<\/p>\n    <p class=\"en-inline\">(This isn't GitHub — it's Supabase, the cloud database service. Before creating a project, Supabase always requires you to first create an “Organization.”)<\/p>\n    <p>会社のような団体を意味する言葉やけど、<b>個人利用でも必ず必要<\/b>な、単なる箱・グループ分けの単位だと考えてよい。<\/p>\n  ", "callout": {"type": "tip", "text": "難しいことは何もない。名前を決めるだけの画面。 (Nothing complicated here — it's just a screen where you pick a name.)"}}, {"title": "Supabaseのサインアップ画面を開く", "titleEn": "Open the Supabase sign-up page", "body": "\n    <div class=\"path\">https://supabase.com/dashboard/sign-up<\/div>\n    <p>ブラウザでこのURLを開く。GitHubアプリではなく、必ずブラウザから。<\/p>\n    <p class=\"en-inline\">(Open this URL in your browser — not the GitHub app.)<\/p>\n  "}, {"title": "ログイン方法を選ぶ", "titleEn": "Choose how to sign up", "body": "\n    <ul class=\"sub-list\">\n      <li><span class=\"dot\"><\/span><span><span class=\"ui-label\">Continue with GitHub <span class=\"en\">(GitHubで続ける)<\/span><\/span> というボタンがあれば、それを選ぶのが一番早い（GitHubアカウントでそのままログインできる）<\/span><\/li>\n      <li><span class=\"dot\"><\/span><span>ボタンが無い、またはメールで登録したい場合：メールアドレスとパスワードを入力し <span class=\"ui-label\">Sign up <span class=\"en\">(サインアップ)<\/span><\/span> → 届いた確認メールのリンクをタップして認証完了<\/span><\/li>\n    <\/ul>\n  ", "callout": {"type": "tip", "text": "GitHubで続けるを選ぶと、ITpassなどを管理している普段使いのアカウントでそのままログインできて楽。 (Using “Continue with GitHub” is the easiest, since it reuses the account you already manage your repos with.)"}}, {"title": "「組織を作る」画面が出てくる", "titleEn": "The “Create an organization” screen appears", "body": "\n    <p>サインアップが終わると、いきなり <span class=\"ui-label\">組織を作る <span class=\"en\">(New organization)<\/span><\/span> という画面になる。これは異常でも失敗でもなく、Supabaseの正規の流れ。<\/p>\n    <p class=\"en-inline\">(Right after signing up, you land on a “New organization” screen. This is normal — not an error.)<\/p>\n  ", "shotNote": "この画面のキャプチャがあれば、ここに『組織を作る』画面を貼り込みます。"}, {"title": "組織の情報を入力する", "titleEn": "Fill in the organization details", "body": "\n    <ul class=\"sub-list\">\n      <li><span class=\"dot\"><\/span><span><span class=\"ui-label\">組織名 <span class=\"en\">(Name)<\/span><\/span>：好きな名前でよい（例：<code>kuramaru<\/code>、<code>itpass<\/code>など）。後から変更でき、他人に見られるものでもない<\/span><\/li>\n      <li><span class=\"dot\"><\/span><span><span class=\"ui-label\">種類 <span class=\"en\">(Type)<\/span><\/span>：<span class=\"ui-label\">個人 <span class=\"en\">(Personal / Just for me)<\/span><\/span> を選ぶ。会社名を入れる欄が出ても、個人利用なら適当な内容でよい<\/span><\/li>\n      <li><span class=\"dot\"><\/span><span><span class=\"ui-label\">プラン <span class=\"en\">(Plan)<\/span><\/span>：必ず <span class=\"ui-label\">Free <span class=\"en\">(無料プラン)<\/span><\/span> を選ぶ<\/span><\/li>\n    <\/ul>\n  ", "callout": {"type": "warn", "text": "有料プランを間違って選ばないよう、プランの表示は必ず確認する。 (Double-check the plan selection so you don't accidentally pick a paid tier.)"}}, {"title": "「組織を作る」を押す", "titleEn": "Click “Create organization”", "body": "\n    <p>入力が終わったら <span class=\"ui-label\">組織を作る <span class=\"en\">(Create organization)<\/span><\/span> ボタンをタップする。<\/p>\n    <p class=\"en-inline\">(Once filled in, tap the “Create organization” button.)<\/p>\n    <p>これで組織の作成は完了。ここは1回作れば以降やり直す必要はない。<\/p>\n  ", "callout": {"type": "ok", "text": "この設定はアカウントにつき最初の1回だけ。次に新しいプロジェクトを作るときも、この組織を使い回せる。 (You only do this once per account — future projects can reuse the same organization.)"}}, {"title": "自動でプロジェクト作成画面に進む", "titleEn": "You're automatically taken to project creation", "body": "\n    <p>組織の作成が終わると、そのまま自動的に<b>新規プロジェクト作成画面<\/b>に移動する。ここで初めて、実際のデータベース（プロジェクト）を作ることになる。<\/p>\n    <p class=\"en-inline\">(Right after creating the organization, you're taken straight to the new project screen — this is where the actual database gets created.)<\/p>\n    <ul class=\"sub-list\">\n      <li><span class=\"dot\"><\/span><span><span class=\"ui-label\">Project name<\/span>：任意の名前（例：<code>itpass<\/code>）<\/span><\/li>\n      <li><span class=\"dot\"><\/span><span><span class=\"ui-label\">Database Password<\/span>：自動生成のままでよい（今回のアプリでは直接使わないため、控える必要はない）<\/span><\/li>\n      <li><span class=\"dot\"><\/span><span><span class=\"ui-label\">Region<\/span>：<code>Northeast Asia (Tokyo)<\/code> を選ぶと通信が速い<\/span><\/li>\n      <li><span class=\"dot\"><\/span><span><span class=\"ui-label\">Create new project<\/span> を押し、1〜2分ほど待つ<\/span><\/li>\n    <\/ul>\n  ", "callout": {"type": "tip", "text": "ここから先の「プロジェクト作成」「接続情報の取得」は、別の手順書として続きを作れる。 (Project creation and getting the connection info can be their own follow-up guide.)"}}]}, {"id": "sync", "part": "PART 3 — Supabase 端末間同期", "icon": "🔗", "title": "テーブル作成〜GitHub反映〜端末連携", "titleEn": "Table, connection info, deploy, and device linking", "desc": "保存先を作り、接続情報をアプリに組み込み、他端末とつなぐまで", "theme": "sb", "steps": [{"title": "これから何をするかの前提", "titleEn": "What this section does", "body": "\n    <p>プロジェクト（データベース本体）はもう出来上がっている状態。ここでは、その中に<b>学習履歴を保存する専用の場所（テーブル）<\/b>を1つ作る。<\/p>\n    <p class=\"en-inline\">(Your project — the database itself — already exists. Here we create one table inside it to store your learning history.)<\/p>\n    <p>使う機能は <span class=\"ui-label\">SQL Editor<\/span>。あらかじめ用意したコード（SQL）を貼り付けて実行するだけで、必要な設定が全部終わる。<\/p>\n  ", "callout": {"type": "tip", "text": "この設定もプロジェクトにつき最初の1回だけでよい。 (Like the earlier setup steps, this only needs to be done once per project.)"}}, {"title": "プロジェクトを開き、左メニューを確認する", "titleEn": "Open the project and check the left menu", "body": "\n    <p>Supabaseにログインし、対象のプロジェクト（例：<code>ITpass<\/code>）を開く。画面上部に <span class=\"ui-label\">組織名 / プロジェクト名 / ブランチ<\/span> が表示されているか確認する。<\/p>\n    <p class=\"en-inline\">(Log in to Supabase and open the target project — check the org/project/branch shown at the top.)<\/p>\n    <div class=\"shot\"><img src=\"data:image/jpeg;base64,\" alt=\"実際の画面：ITpassプロジェクトのトップ画面。左メニューに「SQL Editor」がある\"><div class=\"shot-cap\">実際の画面：ITpassプロジェクトのトップ画面。左メニューに「SQL Editor」がある<\/div><\/div>\n  "}, {"title": "「SQL Editor」を開く", "titleEn": "Open “SQL Editor”", "body": "\n    <p>左側のメニューから <span class=\"ui-label\">SQL Editor<\/span> をタップする。真っ白なコード入力画面（<span class=\"ui-label\">Untitled query<\/span>）が開く。<\/p>\n    <p class=\"en-inline\">(Tap “SQL Editor” in the left menu — a blank code input screen called “Untitled query” opens.)<\/p>\n  "}, {"title": "⚠️ 実行前に必ずブラウザの自動翻訳をオフにする", "titleEn": "Before running anything, turn off browser auto-translate", "body": "\n    <p>スマホ・PCのブラウザには「このページを日本語に翻訳しますか？」という自動翻訳機能がある。<b>これがオンのままだと、SQLコードの中身まで日本語に翻訳されてしまい、実行時にエラーになる。<\/b><\/p>\n    <p class=\"en-inline\">(Browsers often offer to auto-translate a page. If left on, it can translate the SQL code itself into Japanese, breaking it when you run it.)<\/p>\n    <ul class=\"sub-list\">\n      <li><span class=\"dot\"><\/span><span>翻訳のポップアップが出たら「翻訳しない」を選ぶ<\/span><\/li>\n      <li><span class=\"dot\"><\/span><span>すでに翻訳されてしまっている場合は、翻訳バーの「元に戻す <span class=\"en\">(Show original)<\/span>」を押す<\/span><\/li>\n    <\/ul>\n  ", "callout": {"type": "danger", "text": "これを忘れるとSQL文中の英単語（create、select、tableなど）まで日本語化され、意味の通らないコードになって必ずエラーになる。 (Skipping this can translate SQL keywords like create/select/table into Japanese, guaranteeing an error when you run it.)"}}, {"title": "SQLコードを貼り付ける", "titleEn": "Paste in the SQL code", "body": "\n    <p>Claudeから受け取ったSQLコードを、コード入力欄に貼り付ける。例えばこのような内容（内容はアプリによって異なる）：<\/p>\n    <div class=\"path\">create table if not exists sync_data (\n  code text primary key,\n  stats jsonb not null default '{}'::jsonb,\n  favs jsonb not null default '[]'::jsonb,\n  custom jsonb not null default '{}'::jsonb,\n  updated_at timestamptz not null default now()\n);\n\nalter table sync_data enable row level security;\n\ncreate policy \"anon_select\" on sync_data for select to anon using (true);\ncreate policy \"anon_insert\" on sync_data for insert to anon with check (true);\ncreate policy \"anon_update\" on sync_data for update to anon using (true) with check (true);<\/div>\n    <div class=\"shot\"><img src=\"data:image/jpeg;base64,\" alt=\"実際の画面：sync_dataテーブルを作成するSQL（テーブル本体＋アクセス許可の設定）\"><div class=\"shot-cap\">実際の画面：sync_dataテーブルを作成するSQL（テーブル本体＋アクセス許可の設定）<\/div><\/div>\n  ", "callout": {"type": "tip", "text": "このコードの意味を覚える必要はない。貼り付けて実行するだけでよい。 (No need to understand this code line by line — just paste and run it.)"}}, {"title": "❓ このSQLはみんな共通なん？", "titleEn": "Is this SQL the same for every app?", "body": "\n    <p><b>いいえ、違う。<\/b>このSQLは「ITpass（このアプリ）専用」に、Claudeがこのアプリの中身（保存したい項目）に合わせて書いたもの。<code>stats<\/code>（成績）や<code>favs<\/code>（お気に入り）といった列名は、ITpassのJavaScriptコードが実際に読み書きしている項目名とぴったり一致させてある。<\/p>\n    <p class=\"en-inline\">(No — this SQL is written specifically for this app's needs. Column names like stats and favs match exactly what this app's own JavaScript code reads and writes.)<\/p>\n    <p>もし今後、poker（ポーカー道場）やEnglish（英語学習）などの<b>別のアプリ<\/b>にも同じ仕組みを入れたい場合は、そのアプリごとに、Claudeに「このアプリ用のテーブル作成SQLを作って」と頼み直す必要がある。使い回しはできない。<\/p>\n  ", "callout": {"type": "warn", "text": "『同期機能を追加して』とだけ頼むと、Claudeはそのアプリの中身を見た上で、そのアプリ専用のSQLを新しく書いてくれる。他アプリのSQLをそのまま流用しないこと。 (Just ask Claude to “add sync” for that specific app — it will write a fresh, matching SQL script rather than reusing another app's.)"}}, {"title": "「Run」を押して実行する", "titleEn": "Click “Run” to execute", "body": "\n    <p>画面右上の緑色の <span class=\"ui-label\">Run <span class=\"en\">(実行)<\/span><\/span> ボタンをタップする。<\/p>\n    <p class=\"en-inline\">(Tap the green “Run” button in the top-right.)<\/p>\n    <p>成功すると、画面下部に <span class=\"ui-label\">Success<\/span> と表示される。<\/p>\n  ", "callout": {"type": "warn", "text": "2回目以降に同じコードを実行すると「policy “anon_select” for table “sync_data” already exists（既に存在する）」というエラーが出ることがあるが、これは既にテーブルが作成済みという意味なので心配しなくてよい。 (Running it twice may show a “policy already exists” error — that just confirms the table is already set up, not a real problem.)"}}, {"title": "テーブルが作成されたことを確認する", "titleEn": "Confirm the table was created", "body": "\n    <p>同じSQL Editorで、新しいクエリとして次の1行を実行してみる：<\/p>\n    <div class=\"path\">select * from sync_data;<\/div>\n    <p><span class=\"ui-label\">Success. No rows returned <span class=\"en\">(成功。0件)<\/span><\/span> と表示されれば、テーブルは正しく作られている。行数が0件なのは、まだ誰も学習記録を保存していないだけなので正常。<\/p>\n    <div class=\"shot\"><img src=\"data:image/jpeg;base64,\" alt=\"実際の画面：sync_dataテーブルへの問い合わせが成功し、0件で返ってきている状態\"><div class=\"shot-cap\">実際の画面：sync_dataテーブルへの問い合わせが成功し、0件で返ってきている状態<\/div><\/div>\n  ", "callout": {"type": "ok", "text": "ここまで完了すれば、データベース側の準備は終わり。次はアプリ本体（HTML）に、このテーブルへ接続するコードを組み込む番。 (With this done, the database side is ready — next is wiring the app's HTML to connect to this table.)"}}, {"title": "ここから接続情報を取得する", "titleEn": "Next: getting the connection info", "body": "\n    <p>テーブル（保存先の箱）はもう出来上がっている。ここでは、<b>アプリのコード（HTML）がそのテーブルにアクセスできるようにする<\/b>ための2つの情報を取得する。<\/p>\n    <p class=\"en-inline\">(The table already exists. Now we get two pieces of information so the app's code can actually connect to it.)<\/p>\n    <ul class=\"sub-list\">\n      <li><span class=\"dot\"><\/span><span><b>Project URL<\/b>：接続先の住所（<code>https://xxxxx.supabase.co<\/code> の形）<\/span><\/li>\n      <li><span class=\"dot\"><\/span><span><b>Publishable key（公開可能なキー）<\/b>：住所にアクセスするための鍵<\/span><\/li>\n    <\/ul>\n  "}, {"title": "プロジェクトの「Settings（設定）」を開く", "titleEn": "Open the project's “Settings”", "body": "\n    <p>対象プロジェクトを開き、左メニュー一番下の歯車アイコン <span class=\"ui-label\">Project Settings <span class=\"en\">(設定)<\/span><\/span> をタップする。<\/p>\n    <p class=\"en-inline\">(Open the target project and tap the gear icon at the bottom of the left menu.)<\/p>\n  "}, {"title": "「API Keys」を開き、Publishable keyを探す", "titleEn": "Open “API Keys” and find the Publishable key", "body": "\n    <p>設定画面の左メニューから <span class=\"ui-label\">API Keys<\/span> を選ぶ。<span class=\"ui-label\">Publishable key <span class=\"en\">(公開可能なキー)<\/span><\/span> のセクションに、<code>sb_publishable_...<\/code> から始まる文字列がある。<\/p>\n    <p class=\"en-inline\">(In Settings, choose “API Keys.” Under “Publishable key” you'll see a string starting with sb_publishable_...)<\/p>\n    <div class=\"shot\"><img src=\"data:image/jpeg;base64,\" alt=\"実際の画面：API Keys画面。Publishable keyがsb_publishable_...の形で表示されている\"><div class=\"shot-cap\">実際の画面：API Keys画面。Publishable keyがsb_publishable_...の形で表示されている<\/div><\/div>\n    <p>右側のコピーアイコンをタップしてコピーしておく。<\/p>\n  "}, {"title": "🚫 絶対にコピーしたらあかんもの", "titleEn": "What you must never copy", "body": "\n    <p>同じ画面の下の方に <span class=\"ui-label\">Secret keys <span class=\"en\">(シークレットキー)<\/span><\/span> という別のセクションがある。これは<b>絶対にコピーしない・誰にも渡さない・コードに埋め込まない<\/b>。<\/p>\n    <p class=\"en-inline\">(Further down the same screen is a “Secret keys” section — never copy this one, share it, or paste it into any code.)<\/p>\n    <p>旧UIでは <span class=\"ui-label\">service_role<\/span> という名前だったキーがこれにあたる。データベース全体を操作できる管理者権限のキーで、漏れると誰でもデータを書き換え放題になってしまう。<\/p>\n  ", "callout": {"type": "danger", "text": "欲しいのは「Publishable（公開可能）」の方だけ。「Secret（秘密）」と書かれた方には触れない。 (You only ever need the “Publishable” key — never touch anything labeled “Secret.”)"}}, {"title": "「Data API」を開き、Project URLを探す", "titleEn": "Open “Data API” and find the Project URL", "body": "\n    <p>同じ設定画面の左メニューを下にたどると、<span class=\"ui-label\">INTEGRATIONS <span class=\"en\">(統合)<\/span><\/span> というグループの中に <span class=\"ui-label\">Data API<\/span> という項目がある。それをタップする。<\/p>\n    <p class=\"en-inline\">(In the same left menu, under the “INTEGRATIONS” group, tap “Data API.”)<\/p>\n    <div class=\"shot\"><img src=\"data:image/jpeg;base64,\" alt=\"実際の画面：左メニュー。CONFIGURATIONの「API Keys」の下、INTEGRATIONSに「Data API」がある\"><div class=\"shot-cap\">実際の画面：左メニュー。CONFIGURATIONの「API Keys」の下、INTEGRATIONSに「Data API」がある<\/div><\/div>\n    <p>開いた画面に <span class=\"ui-label\">Project URL<\/span> または <span class=\"ui-label\">URL<\/span> として、<code>https://xxxxxxxxxxxx.supabase.co<\/code> という形式のURLが表示される。それが探している値。<\/p>\n  ", "shotNote": "この画面（Data APIを開いた後の実際の表示）のキャプチャがあれば、ここに貼り込みます。"}, {"title": "2つの情報をClaudeに渡す", "titleEn": "Hand both values to Claude", "body": "\n    <p>コピーした2つの値を、Claudeとのチャットに貼り付ける：<\/p>\n    <ul class=\"sub-list\">\n      <li><span class=\"dot\"><\/span><span>Project URL（<code>https://xxxxx.supabase.co<\/code>）<\/span><\/li>\n      <li><span class=\"dot\"><\/span><span>Publishable key（<code>sb_publishable_...<\/code>）<\/span><\/li>\n    <\/ul>\n    <p>Claudeはこの2つをアプリのコードに埋め込んだ、<b>更新版のindex.html全体<\/b>を返してくれる。<\/p>\n  ", "callout": {"type": "warn", "text": "Secret key（シークレットキー）は絶対に貼り付けない。Publishable keyだけを渡す。 (Never paste the Secret key here — only the Publishable key.)"}}, {"title": "受け取った新しいindex.htmlをGitHubに反映する", "titleEn": "Push the new index.html to GitHub", "body": "\n    <p>ここから先は第3章「既存ファイルの修正と更新」の手順とまったく同じ。<\/p>\n    <ol class=\"sub-list\" style=\"list-style:decimal;padding-left:20px;\">\n      <li>対象リポジトリの <code>index.html<\/code> を開く<\/li>\n      <li>右上の鉛筆アイコンで編集モードに入る<\/li>\n      <li>中身を全選択して削除し、Claudeから受け取った新しいコードを丸ごと貼り付ける<\/li>\n      <li>画面下までスクロールし、緑の <span class=\"ui-label\">Commit changes<\/span> を押す<\/li>\n    <\/ol>\n  ", "callout": {"type": "tip", "text": "詳しい画面の流れは第3章「既存ファイルの修正と更新」を参照。ここでは同じ手順を繰り返すだけでよい。 (For the detailed screen-by-screen flow, see the “Editing and updating an existing file” guide — this is the same steps repeated.)"}}, {"title": "公開サイトで反映を確認する", "titleEn": "Confirm it went live", "body": "\n    <p>コミット後、1〜2分待ってから公開URL（例：<code>https://usoyanda.github.io/ITpass/<\/code>）を開き直す。<\/p>\n    <p class=\"en-inline\">(Wait a minute or two after committing, then reload the live URL.)<\/p>\n    <p>アプリの中に「端末間の同期」のような項目が表示されていれば、コードの反映は成功している。<\/p>\n  "}, {"title": "同期コードで端末をつなぐ", "titleEn": "Link devices with a sync code", "body": "\n    <p>最初の1台（例：会社PC）で、アプリの「端末間の同期」から <span class=\"ui-label\">この端末で新しくコードを発行する<\/span> を押す。表示された8桁のコード（例：<code>X7K2P9QM<\/code>）をメモする。<\/p>\n    <p class=\"en-inline\">(On the first device, generate a new sync code and note the 8-character code shown.)<\/p>\n    <p>2台目以降（スマホ・自宅PCなど）では、同じ欄にそのコードを入力して <span class=\"ui-label\">このコードで接続する<\/span> を押す。これで1台目の記録が反映される。<\/p>\n  ", "callout": {"type": "ok", "text": "一度コードを入力すれば、その端末は自動的に記録を送受信し続ける。以降は特別な操作は不要。 (Once entered, the device keeps syncing automatically — no further action needed.)"}}]}];

const $ = id => document.getElementById(id);
let cur = null, idx = 0;

const isNote = s => s.title.startsWith("❓");
function tagOf(ch, i){
  const s = ch.steps[i];
  if(isNote(s)) return "補足 (Note)";
  const numbered = ch.steps.filter(x=>!isNote(x));
  return `STEP ${numbered.indexOf(s)+1} / ${numbered.length}`;
}
function calloutHtml(c){
  if(!c) return "";
  const icons={warn:"⚠️",tip:"💡",ok:"✅",danger:"🚫"};
  return `<div class="callout ${c.type}"><span>${icons[c.type]||"ℹ️"}</span><span>${c.text}</span></div>`;
}
function shotNoteHtml(s){ return s ? `<div class="shot-note">🖼 <b>画面キャプチャ枠</b><br>${s}</div>` : ""; }
function stepHtml(ch,i){
  const s = ch.steps[i];
  return `<div class="step-tag">${tagOf(ch,i)}</div>
    <div class="step-title">${s.title}<span class="en">${s.titleEn}</span></div>
    <div class="step-body">${s.body}${calloutHtml(s.callout)}${shotNoteHtml(s.shotNote)}</div>`;
}

/* ---- TOC ---- */
function renderToc(){
  let html="", lastPart="";
  CHAPTERS.forEach((c,i)=>{
    if(c.part!==lastPart){ html+=`<div class="part">${c.part}</div>`; lastPart=c.part; }
    const n = c.steps.filter(x=>!isNote(x)).length;
    html+=`<button class="toc-item" data-i="${i}">
      <div class="toc-no ${c.theme}">${i+1}</div>
      <div class="toc-body">
        <div class="toc-title">${c.icon} ${c.title}<span class="en">${c.titleEn}</span></div>
        <div class="toc-desc">${c.desc}</div>
      </div>
      <div class="toc-count">${n} STEPS</div>
    </button>`;
  });
  $("tocList").innerHTML = html;
  document.querySelectorAll(".toc-item").forEach(b=>b.onclick=()=>openChapter(+b.dataset.i));
}

/* ---- Chapter ---- */
function openChapter(i, step=0){
  cur = i; idx = step;
  const ch = CHAPTERS[i];
  document.body.className = "theme-"+ch.theme;
  $("toc").classList.add("hidden");
  $("chapter").classList.remove("hidden");
  $("chapNo").textContent = `CHAPTER ${i+1} / ${CHAPTERS.length}`;
  $("chapTitle").textContent = `${ch.icon} ${ch.title}`;
  $("chapTitleEn").textContent = ch.titleEn;
  $("stepper").classList.remove("hidden");
  $("doneView").classList.add("hidden");
  $("allView").classList.add("hidden");
  $("showAllBtn").parentElement.classList.remove("hidden");
  $("showAllBtn").textContent = "すべてのステップを表示 (Show all steps)";
  location.hash = ch.id;
  update();
  window.scrollTo(0,0);
}
function update(){
  const ch = CHAPTERS[cur];
  $("cardBody").innerHTML = stepHtml(ch, idx);
  $("dots").innerHTML = ch.steps.map((s,i)=>
    `<button class="dot-btn ${i===idx?'active':(i<idx?'done':'')} ${isNote(s)?'note':''}" data-i="${i}" title="${s.title.replace(/"/g,'')}">${isNote(s)?'?':i+1-ch.steps.slice(0,i).filter(isNote).length}</button>`).join("");
  document.querySelectorAll(".dot-btn").forEach(b=>b.onclick=()=>{idx=+b.dataset.i;update();});
  $("pf").style.width = (ch.steps.length>1 ? idx/(ch.steps.length-1)*100 : 100)+"%";
  $("pl").textContent = `${idx+1} / ${ch.steps.length}`;
  $("prevBtn").disabled = idx===0;
  $("nextBtn").textContent = idx===ch.steps.length-1 ? "この章を完了" : "次へ";
}
$("prevBtn").onclick = ()=>{ if(idx>0){idx--;update();window.scrollTo(0,0);} };
$("nextBtn").onclick = ()=>{
  const ch = CHAPTERS[cur];
  if(idx < ch.steps.length-1){ idx++; update(); window.scrollTo(0,0); return; }
  $("stepper").classList.add("hidden");
  $("showAllBtn").parentElement.classList.add("hidden");
  $("pf").style.width="100%";
  const hasNext = cur < CHAPTERS.length-1;
  $("doneView").innerHTML = `<div class="card done-screen">
      <div class="big">🎉</div>
      <h3>「${ch.title}」は以上です</h3>
      <p>(End of this chapter.)</p>
      <div class="done-actions">
        <button class="btn ghost" id="dToc">目次に戻る</button>
        ${hasNext?`<button class="btn primary" id="dNext" style="flex:0 1 auto">次の章へ：${CHAPTERS[cur+1].title}</button>`:""}
      </div></div>`;
  $("doneView").classList.remove("hidden");
  $("dToc").onclick = showToc;
  if(hasNext) $("dNext").onclick = ()=>openChapter(cur+1);
};
$("showAllBtn").onclick = ()=>{
  const showing = !$("allView").classList.contains("hidden");
  if(showing){
    $("allView").classList.add("hidden"); $("stepper").classList.remove("hidden");
    $("showAllBtn").textContent = "すべてのステップを表示 (Show all steps)";
  }else{
    const ch = CHAPTERS[cur];
    $("allView").innerHTML = ch.steps.map((s,i)=>`<div class="card">${stepHtml(ch,i)}</div>`).join("");
    $("allView").classList.remove("hidden"); $("stepper").classList.add("hidden");
    $("showAllBtn").textContent = "1ステップずつ表示に戻る (Back to step-by-step)";
  }
};
function showToc(){
  document.body.className = "";
  $("chapter").classList.add("hidden");
  $("toc").classList.remove("hidden");
  history.replaceState(null,"",location.pathname);
  window.scrollTo(0,0);
}
$("backBtn").onclick = showToc;

renderToc();
const h = location.hash.slice(1);
const hi = CHAPTERS.findIndex(c=>c.id===h);
if(hi>=0) openChapter(hi);
</script>
</body>
</html>
